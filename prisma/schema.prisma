generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"

  // PostgreSQL (production):
  // provider = "postgresql"
}

enum FestivalStatus {
  DRAFT
  PUBLISHED
}

enum BookStatus {
  DRAFT
  PUBLISHED
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
}

// USERS + ROLES

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  password         String?
  image            String?
  twoFactorEnabled Boolean   @default(false)

  roles     UserRole[]
  festivals Festival[]
  orisas    Orisa[]
  tickets   Ticket[]
  books     Book[]
  bookOrders BookOrder[]

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@map("app_user")

  @@map("user")
}

model Role {
  id    String     @id @default(cuid())
  name  String     @unique @default("USER") // USER, CREATOR, MODERATOR, ADMIN, SUPERADMIN
  users UserRole[]
}

model UserRole {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  role   Role   @relation(fields: [roleId], references: [id])
  roleId String

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ORISA

model Orisa {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  festivals Festival[]
}

model Festival {
  id          Int    @id @default(autoincrement())
  title       String
  description String

  orisaId Int
  orisa   Orisa @relation(fields: [orisaId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Step 2: Event Details
  country   String
  eventType String // "physical" or "virtual"
  location  String? // optional if virtual
  eventLink String? // optional if physical
  timezone  String
  startDate DateTime
  startTime String? // optional, for UI convenience (HH:mm)
  endDate   DateTime
  endTime   String? // optional, for UI convenience (HH:mm)

  status FestivalStatus @default(DRAFT)

  // Step 3: Tickets
  ticketType String // "single" | "group"
  tickets    Ticket[]

  image  String? // could store path or URL
  banner String? // could store path or URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id         Int      @id @default(autoincrement())
  festival   Festival @relation(fields: [festivalId], references: [id])
  festivalId Int

  creator   User   @relation(fields: [creatorId], references: [id])
  creatorId String

  name        String
  type        String // "single" | "group"
  isFree      Boolean
  price       Float? // required if isFree = false
  quantity    Int // total available tickets
  maxPerGroup Int? // max tickets per person/group
  sold        Int     @default(0) // track how many tickets sold

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// BOOKS SHOP

model Book {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  author      String
  price       Float      // price in NGN
  currency    String     @default("NGN")
  coverImage  String?
  stock       Int        @default(0)
  status      BookStatus @default(DRAFT)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  orders BookOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookOrder {
  id                Int         @id @default(autoincrement())
  bookId            Int
  book              Book        @relation(fields: [bookId], references: [id])
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  amount            Int         // amount in kobo
  paystackReference String      @unique
  status            OrderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NEXTAUTH

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
