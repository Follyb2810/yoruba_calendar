generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"

  // PostgreSQL (production):
  // provider = "postgresql"
}

enum FestivalStatus {
  DRAFT
  PUBLISHED
}

enum BookStatus {
  DRAFT
  PUBLISHED
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum PayoutStatus {
  PENDING     // awaiting fulfillment or bank setup
  PROCESSING  // Paystack transfer initiated
  COMPLETED   // creator paid
  FAILED
  SKIPPED     // free order
}

// USERS + ROLES

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  password         String?
  image            String?
  twoFactorEnabled Boolean   @default(false)

  // Paystack Transfer recipient for creator payouts
  paystackRecipientCode String?
  payoutBankCode        String?
  payoutBankName        String?
  payoutAccountName     String?
  payoutAccountLast4    String?

  roles     UserRole[]
  festivals Festival[]
  orisas    Orisa[]
  tickets   Ticket[]
  books     Book[]
  bookOrders BookOrder[]
  ticketOrders TicketOrder[]

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@map("app_user")

  @@map("user")
}

model Role {
  id    String     @id @default(cuid())
  name  String     @unique @default("USER") // USER, CREATOR, MODERATOR, ADMIN, SUPERADMIN
  users UserRole[]
}

model UserRole {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  role   Role   @relation(fields: [roleId], references: [id])
  roleId String

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ORISA

model Orisa {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  festivals Festival[]
}

model Festival {
  id          Int    @id @default(autoincrement())
  title       String
  description String

  orisaId Int
  orisa   Orisa @relation(fields: [orisaId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Step 2: Event Details
  country   String
  eventType String // "physical" or "virtual"
  location  String? // optional if virtual
  eventLink String? // optional if physical
  timezone  String
  startDate DateTime
  startTime String? // optional, for UI convenience (HH:mm)
  endDate   DateTime
  endTime   String? // optional, for UI convenience (HH:mm)

  status FestivalStatus @default(DRAFT)

  // Step 3: Tickets
  ticketType String // "single" | "group"
  tickets    Ticket[]
  ticketOrders TicketOrder[]

  image  String? // could store path or URL
  banner String? // could store path or URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id         Int      @id @default(autoincrement())
  festival   Festival @relation(fields: [festivalId], references: [id])
  festivalId Int

  creator   User   @relation(fields: [creatorId], references: [id])
  creatorId String

  name        String
  type        String // "single" | "group"
  isFree      Boolean
  price       Float? // required if isFree = false
  quantity    Int // total available tickets
  maxPerGroup Int? // max tickets per person/group
  sold        Int     @default(0) // track how many tickets sold

  orders TicketOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketOrder {
  id                Int         @id @default(autoincrement())
  ticketId          Int
  ticket            Ticket      @relation(fields: [ticketId], references: [id])
  festivalId        Int
  festival          Festival    @relation(fields: [festivalId], references: [id])
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  quantity          Int         @default(1)
  amount            Int         // amount in kobo (0 for free)
  paystackReference String      @unique
  status            OrderStatus @default(PENDING)
  buyerPhone        String?

  sellerAcknowledgedAt DateTime?

  fulfilledAt DateTime? // organizer marked complete (buyer attended / ticket honored)

  payoutStatus              PayoutStatus @default(PENDING)
  creatorPayoutAmount       Int?         // kobo sent to creator
  platformFeeAmount         Int?
  paystackTransferReference String?      @unique
  payoutCompletedAt         DateTime?

  feedbackToken     String?   @unique
  buyerRating       Int?      // 1–5 satisfaction
  buyerComment      String?
  buyerFeedbackAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// BOOKS SHOP

model Book {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  author      String
  price       Float      // price in NGN
  currency    String     @default("NGN")
  coverImage  String?   // front cover photo only (not the book file)
  backImage   String?   // back cover photo (optional)
  stock       Int        @default(0)
  status      BookStatus @default(DRAFT)

  allowsDelivery  Boolean @default(true)
  allowsPickup    Boolean @default(true)
  pickupLocation  String? // where buyers can collect (city/address)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  orders BookOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookOrder {
  id                Int         @id @default(autoincrement())
  bookId            Int
  book              Book        @relation(fields: [bookId], references: [id])
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  amount            Int         // amount in kobo
  paystackReference String            @unique
  status            OrderStatus       @default(PENDING)
  fulfillmentMethod FulfillmentMethod @default(PICKUP)
  deliveryAddress   String?
  deliveryCity      String?
  deliveryPhone     String?
  pickupLocation    String?

  sellerAcknowledgedAt DateTime? // null = new order notification for seller
  fulfilledAt          DateTime? // seller marked order complete (book delivered / event served)

  payoutStatus              PayoutStatus @default(PENDING)
  creatorPayoutAmount       Int?
  platformFeeAmount         Int?
  paystackTransferReference String?      @unique
  payoutCompletedAt         DateTime?

  feedbackToken     String?   @unique
  buyerRating       Int?
  buyerComment      String?
  buyerFeedbackAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NEXTAUTH

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
